// wiki.db schema (SQLite STRICT) — ERD mirror of wiki.sql (same directory).
//
// Reflects the CURRENT schema, in which two lanes coexist:
//   - raw-article synthesis path: entities / pages / page_sources /
//     page_versions / entity_relations / processed_items
//   - attributed lane (additive): sources / claims / claim_entities
// The cutover that retires the raw path (page_type -> entity_type rename, drop
// page_sources / page_versions, source_id-key entity_relations) is a later
// slice; update this file alongside wiki.sql when it lands.
//
// Enums below are TEXT + CHECK in SQLite (STRICT has no native enum); modelled
// as Enum here for the diagram. Paste into https://dbdiagram.io to render.

Enum processed_status {
  ok
  error
  skipped
}

Enum claim_kind {
  reported
  opinion
}

// ---- identity + raw-article synthesis path ----

Table entities {
  entity_id       text [pk, note: 'e_<16hex> opaque surrogate, minted once']
  canonical_name  text [not null]
  normalized_name text [not null, unique, note: 'lower/trim/collapse-ws dedup key']
  slug            text [not null]
  page_type       text [not null, note: 'open-domain type label; renamed entity_type at cutover']
  created_at      text [not null]
}

Table pages {
  entity_id       text [pk, ref: - entities.entity_id]
  file_path       text [not null, unique, note: 'flat {slug}-{shortid}.md']
  related_ids     text [note: 'JSON array of related entity_ids (advisory)']
  updated_at      text [not null]
  content_hash    text [note: 'HEAD semantic hash of current edition']
  current_version integer [note: 'HEAD pointer into page_versions']
  Note: 'One synthesised-artifact record per entity (1:1).'
}

Table aliases {
  alias            text [not null, note: 'display form']
  normalized_alias text [pk, note: 'globally-unique match key']
  entity_id        text [not null, ref: > entities.entity_id]
  indexes {
    entity_id [name: 'idx_aliases_entity_id']
  }
}

Table page_sources {
  entity_id   text [not null, ref: > entities.entity_id]
  item_id     text [not null]
  source_type text [not null]
  added_at    text [not null]
  indexes {
    (entity_id, item_id, source_type) [pk]
    entity_id [name: 'idx_page_sources_entity_id']
  }
  Note: 'Raw-path contribution ledger; num_sources derived. Dropped at cutover.'
}

Table page_versions {
  entity_id    text [not null, ref: > entities.entity_id]
  version      integer [not null, note: 'monotonic per entity']
  created_at   text [not null]
  content_hash text [not null]
  summary      text [not null]
  num_sources  integer [not null, note: 'CHECK >= 0']
  source_id    text [not null]
  source_type  text [not null]
  content      text [not null, note: 'full markdown body at this edition']
  indexes {
    (entity_id, version) [pk]
  }
  Note: 'Raw-path edition history. Deferred / dropped at cutover.'
}

Table entity_relations {
  entity_id         text [not null, ref: > entities.entity_id]
  related_entity_id text [not null, ref: > entities.entity_id]
  item_id           text [not null]
  source_type       text [not null]
  added_at          text [not null]
  indexes {
    (entity_id, related_entity_id, item_id, source_type) [pk]
    entity_id [name: 'idx_entity_relations_entity_id']
  }
  Note: 'Co-occurrence ledger (item-keyed). The attributed lane does not write this yet.'
}

Table processed_items {
  item_id      text [not null]
  source_type  text [not null]
  status       processed_status [not null]
  error        text
  processed_at text [not null]
  indexes {
    (item_id, source_type) [pk]
  }
  Note: 'Raw-path synthesis-attempt ledger.'
}

Table rejected_entities {
  normalized_name text [pk, note: 'match key: lower/trim/collapse-ws']
  category        text
  reason          text
  rejected_at     text [not null]
  Note: 'Authored curator denylist. Survives a from-empty rebuild.'
}

// ---- attributed lane (additive) ----

Table sources {
  source_id    text [pk, note: 'src_<16hex>']
  content_key  text [not null, unique, note: 'normalized canonical URL / <source>::<url>']
  origin_type  text [not null, note: 'queue / raw_store / session / research']
  title        text
  author       text
  publication  text [note: 'e.g. the Medium publication, for attribution']
  url          text
  published_at text [note: 'ISO-8601 date or null']
  content_hash text [note: 'fetched-body hash — detect article change']
  fetched_at   text
  added_at     text [not null]
  Note: 'Source registry + attribution metadata. Write helper UPSERTs on content_key.'
}

Table claims {
  claim_id   text [pk, note: 'clm_<16hex>']
  source_id  text [not null, ref: > sources.source_id, note: 'ON DELETE CASCADE']
  text       text [not null]
  text_hash  text [not null, note: 'sha256(normalized text)']
  claim_kind claim_kind [not null]
  created_at text [not null]
  indexes {
    (source_id, text_hash) [unique, name: 'uq_claim_idempotency']
    source_id [name: 'idx_claims_source']
  }
  Note: 'Atomic attributed claim. UNIQUE(source_id, text_hash) = idempotent re-run.'
}

Table claim_entities {
  claim_id  text [not null, ref: > claims.claim_id, note: 'ON DELETE CASCADE']
  entity_id text [not null, ref: > entities.entity_id, note: 'ON DELETE CASCADE']
  indexes {
    (claim_id, entity_id) [pk]
    (entity_id, claim_id) [name: 'idx_claim_entities_entity']
  }
  Note: 'Many-to-many bridge: claim -> subject entity(ies), 0..N.'
}
