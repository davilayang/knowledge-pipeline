# Copy to .env and fill in values. Optional vars short-circuit cleanly when unset.

# --- Dagster Postgres (docker-compose only) ---
DAGSTER_PG_HOST=postgres
DAGSTER_PG_PORT=5432
DAGSTER_PG_USERNAME=...
DAGSTER_PG_PASSWORD=...
DAGSTER_PG_DB=dagster

# --- LLM API keys ---
## used by: workflows/
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...           # optional — only when using Claude

# --- Langfuse Tracing (optional) ---
## used by:
LANGFUSE_PUBLIC_KEY=...
LANGFUSE_SECRET_KEY=...
LANGFUSE_HOST=https://cloud.langfuse.com

# DATABASE_URL is composed in docker-compose.yml from DAGSTER_PG_*; for local
# `poe dev` outside docker, set it explicitly:
# DATABASE_URL=postgresql://${DAGSTER_PG_USERNAME}:${DAGSTER_PG_PASSWORD}@localhost:5432/knowledge_pipeline

# --- backup_readings DAG (all optional) ---
# In Docker Compose, BACKUP_SOURCE_DIR is the HOST path; compose bind-mounts it
# to /app/source inside the container and overrides BACKUP_SOURCE_DIR there to
# the fixed container path. Outside Docker, BACKUP_SOURCE_DIR is read directly.
# Compose does NOT tilde-expand — use ${HOME}/... or an absolute path.
BACKUP_SOURCE_DIR=${HOME}/newsletter-assistant/data
BACKUP_DIR=./backups
DRIVE_REMOTE=gdrive                  # rclone remote; unset disables Drive offload + prune
# HEALTHCHECK_PING_URL=https://hc-ping.com/<uuid>
