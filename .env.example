# Copy to .env and fill in values. Lines marked "(optional)" can be left
# commented; their consumers short-circuit when unset.

# --- Dagster Postgres (consumed by docker-compose.yml) ---
DAGSTER_PG_HOST=postgres
DAGSTER_PG_PORT=5432
DAGSTER_PG_USERNAME=...
DAGSTER_PG_PASSWORD=...
DAGSTER_PG_DB=dagster

# --- LLM (used by wiki synthesis pipeline) ---
OPENAI_API_KEY=sk-...

# --- backup_readings DAG (all optional) ---

# Source SQLite DBs. Default = ~/newsletter-assistant/data (server layout).
# Set on laptops where the source lives elsewhere.
# BACKUP_SOURCE_DIR=~/GitHub/newsletter-assistant/data

# Local snapshot landing dir. Default = <repo>/backups.
# BACKUP_DIR=

# rclone remote name. Unset → Drive upload + capacity check + Drive prune
# all short-circuit; run still succeeds (local-only mode).
# DRIVE_REMOTE=gdrive

# healthchecks.io ping URL. Unset → ping_healthcheck_on_success sensor
# short-circuits. Set this on production so missed runs alert.
# HEALTHCHECK_PING_URL=https://hc-ping.com/<uuid>
