# ─── Container runtime (docker-compose only) ──────────────────────
# Match the host deploy user so bind-mounted dirs (data/, logs/,
# backups/, .rclone/) are owned correctly without host-side chown.
# Run on the deploy host:
#   APP_UID=$(id -u)
#   APP_GID=$(id -g)
APP_UID=
APP_GID=
# Webserver bind: 127.0.0.1:3030 is always bound; APP_HOST adds a
# second binding. Set 172.17.0.1 on Caddy-fronted servers.
# APP_HOST=172.17.0.1
# Jupyter is disabled by default; uncomment when running `poe nb`.
# JUPYTER_SERVER_TOKEN=local-jupyter-dev-token

# ─── Postgres ─────────────────────────────────────────────────────
# Dagster run history + LangGraph checkpoints + wiki state.
DAGSTER_PG_HOST=postgres
DAGSTER_PG_PORT=5432
DAGSTER_PG_USERNAME=...
DAGSTER_PG_PASSWORD=...
DAGSTER_PG_DB=dagster
# Local-only: docker-compose composes DATABASE_URL from DAGSTER_PG_*.
# Set explicitly only when running `poe dev` outside docker:
# DATABASE_URL=postgresql://${DAGSTER_PG_USERNAME}:${DAGSTER_PG_PASSWORD}@localhost:5432/knowledge_pipeline

# ─── OpenAI ───────────────────────────────────────────────────────
# Shared by fetch_extract_queue (extractor), populate_vector_store
# (embeddings), synthesize_wiki (LLM calls), triage_knowledge_queue
# (content_shape classifier fallback tier), and the fetcher's
# /v1/structure cloud LLM chain.
OPENAI_API_KEY=sk-...

# ─── Ollama Cloud ─────────────────────────────────────────────────
# Fetcher's /v1/structure primary tier (OpenAI-compat shim — see
# services/fetcher/config/structurer.yaml). Optional; falls through
# to OpenAI when unset.
OLLAMA_API_KEY=

# ─── Groq ─────────────────────────────────────────────────────────
# Two consumers:
#  - Content_shape classifier primary tier (llama-3.3-70b-versatile via
#    OpenAI-compat endpoint). Unset → falls back to OpenAI gpt-4.1-mini,
#    or content_shape lands as "unknown" if both unset.
#  - Fetcher podcast handler: Whisper primary tier (whisper-large-v3-turbo
#    via OpenAI-compat). Unset → falls back to OpenAI whisper-1.
GROQ_API_KEY=

# ─── Notion (per-database integration tokens, least privilege) ────
# One integration per Notion database, connected ONLY to that DB — a leaked
# token can't reach the other DB. Each needs read + update capability.
# Queue DB token (triage_knowledge_queue + fetch_extract_queue: read queue,
# write triaged/enriched/failed/skipped status back).
NOTION_QUEUE_TOKEN=secret_...
# Wiki Pages DB token — NOT used yet (synthesis reads the local rejected_entities
# table). For the forthcoming sync_wiki_curation DAG: read Rejected, push entities.
NOTION_WIKI_TOKEN=secret_...
# Knowledge OS Queue DB id (with or without dashes).
NOTION_QUEUE_DB_ID=...
# Data source id under the Queue DB (Notion 2.x queries hit data
# sources, not databases). Fetch the DB once and read
# `data_sources[0].id`, or copy from a create-database response.
NOTION_QUEUE_DATA_SOURCE_ID=...
# Data source id of the "Wiki Pages" DB. NOT used yet (synthesis reads the
# local rejected_entities table) — reserved for the forthcoming
# sync_wiki_curation DAG, alongside NOTION_WIKI_TOKEN.
NOTION_WIKI_DATA_SOURCE_ID=...

# ─── Fetcher (extract → fetcher service) ──────────────────────────
# URL → markdown service.
FETCHER_URL=http://localhost:8765              # compose pins this to http://fetcher:8000 for dagster-code
FETCHER_TIMEOUT_S=60                           # orchestrator-side httpx client timeout
FETCHER_ALLOW_PAID=false                       # arxiv escalates to LlamaParse when true

# ─── Fetcher service (own settings, validated at boot) ────────────
# Required — boot fails / healthz returns 503 listing the missing keys:
FETCHER_SOCKS5_URL=socks5://raspberry-pi-host:1080   # SOCKS5 proxy used by curl_cffi fallback
FETCHER_LLAMA_PARSE_API_KEY=
# Optional API keys (the dependent tier becomes unreachable when unset):
FETCHER_JINA_API_KEY=                          # paid tier; free tier works without auth
FETCHER_TAVILY_API_KEY=                        # article handler — tavily tier
FETCHER_RAPIDAPI_KEY=                          # Medium paywall bypass (mediumapi.com)
# Structurer keys (/v1/structure + transcript structurer) read OPENAI_API_KEY +
# OLLAMA_API_KEY directly — shared with orchestrator; see OpenAI / Ollama sections above.
# Podcast handler (Whisper transcription) reads GROQ_API_KEY + OPENAI_API_KEY.
FETCHER_YOUTUBE_STRUCTURER_ENABLED=true        # cloud structurer over YouTube auto-captions; set false to opt out per-deploy

# ─── DAG: fetch_extract_queue ────────────────────────────────
EXTRACT_QUEUE_MODEL=gpt-4o-mini                # dev; switch to gpt-4o for prod

# ─── DAG: populate_vector_store ───────────────────────────────────
CHROMA_HOST=localhost                          # compose sets this to the `chroma` service for dagster-code
CHROMA_PORT=8000

# ─── DAG: backup_readings (all required) ──────────────────────────
BACKUP_SRC_DIR=/home/.../newsletter-assistant/data    # compose bind-mounts to /app/source inside dagster-code
BACKUP_DST_DIR=/home/.../knowledge-pipeline/backups
DRIVE_REMOTE=gdrive                            # rclone remote name
DRIVE_BACKUP_ROOT=...backups-dev               # path prefix on the remote
HEALTHCHECK_PING_URL="https://hc-ping.com/<uuid>"

# ─── Langfuse (optional tracing) ──────────────────────────────────
# Traces synthesize_wiki + extraction runs.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development       # "production" on deploy
