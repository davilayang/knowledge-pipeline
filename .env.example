# Copy to .env and fill in values. Optional vars short-circuit cleanly when unset.

# --- Container user uid/gid ---
# Match the host deploy user so bind-mounted dirs (./data, ./logs, ./backups,
# ./.rclone) work without any chown. On Linux: APP_UID=$(id -u), APP_GID=$(id -g).
# Default 1001 is fine for first-time setup; rebuild the image after changing.
APP_UID=1001
APP_GID=1001

# --- Webserver bind ---
# 127.0.0.1:3030 is always bound. APP_HOST adds a second binding;
# default 127.0.0.2 (no-op), set 172.17.0.1 on Caddy-fronted servers.
# APP_HOST=127.0.0.2

# --- Dagster Postgres (docker-compose only) ---
DAGSTER_PG_HOST=postgres
DAGSTER_PG_PORT=5432
DAGSTER_PG_USERNAME=...
DAGSTER_PG_PASSWORD=...
DAGSTER_PG_DB=dagster

# --- LLM API keys ---
## used by: workflows/wiki_synthesis (required to run synthesize_wiki)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...           # optional — only when using Claude

# --- Langfuse Tracing (optional) ---
## used by: workflows/wiki_synthesis (traces every synthesize_content run)
LANGFUSE_PUBLIC_KEY=...
LANGFUSE_SECRET_KEY=...
LANGFUSE_HOST=https://cloud.langfuse.com

# DATABASE_URL is composed in docker-compose.yml from DAGSTER_PG_*;
# for local `poe dev` outside docker, set it explicitly:
# DATABASE_URL=postgresql://${DAGSTER_PG_USERNAME}:${DAGSTER_PG_PASSWORD}@localhost:5432/knowledge_pipeline

# --- DAG synthesize_wiki ---
# Required: DATABASE_URL (above) and OPENAI_API_KEY (above).
# Optional: LANGFUSE_* (above) for LLM tracing.
# No pipeline-specific env vars beyond those — paths and max_articles
# live on WikiResource defaults in synthesize_wiki/resources.py.

# --- DAG backup_readings ---
BACKUP_SOURCE_DIR=/home/.../newsletter-assistant/data  # Only absolute path
BACKUP_DIR=./backups                                   # local landing dir
DRIVE_REMOTE=gdrive                                    # rclone remote name
DRIVE_BACKUP_ROOT=...backups-dev                       # path prefix on the remote
HEALTHCHECK_PING_URL=https://hc-ping.com/<uuid>
