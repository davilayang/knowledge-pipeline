# Source project path (defaults to ~/GitHub/newsletter-assistant)
# NEWSLETTER_ASSISTANT_DIR=~/GitHub/newsletter-assistant

# Dagster PostgreSQL connection (used by docker-compose)
DAGSTER_PG_HOST=postgres
DAGSTER_PG_PORT=5432
DAGSTER_PG_USERNAME=...
DAGSTER_PG_PASSWORD=...
DAGSTER_PG_DB=dagster

# LLM API keys (used by wiki synthesis + future judge models)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Langfuse Tracing (optional — leave blank to disable)
LANGFUSE_PUBLIC_KEY=...
LANGFUSE_SECRET_KEY=...
LANGFUSE_HOST=https://cloud.langfuse.com

# Application database — wiki tables + langgraph_checkpoints
# In docker compose, host=postgres; for local `uv run poe dev`, host=localhost
DATABASE_URL=postgresql://${DAGSTER_PG_USERNAME}:${DAGSTER_PG_PASSWORD}@postgres:5432/knowledge_pipeline
