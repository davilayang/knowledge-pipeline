# --- Container user uid/gid ---
# MUST match the host deploy user's id values so bind-mounted dirs
# (./data, ./logs, ./backups, ./.rclone) are owned correctly inside the
# container with no host-side chown. Run on the deploy host:
# APP_UID=(id -u)
# APP_GID=(id -g)

# --- Jupyter Server ---
JUPYTER_SERVER_TOKEN=local-jupyter-dev-token

# --- Webserver bind ---
# 127.0.0.1:3030 is always bound. APP_HOST adds a second binding;
# default 127.0.0.2 (no-op), set 172.17.0.1 on Caddy-fronted servers.
# APP_HOST=172.17.0.1

# --- Dagster Postgres (docker-compose only) ---
DAGSTER_PG_HOST=postgres
DAGSTER_PG_PORT=5432
DAGSTER_PG_USERNAME=...
DAGSTER_PG_PASSWORD=...
DAGSTER_PG_DB=dagster

# --- LLM API keys ---
## used by: workflows/wiki_synthesis (required to run synthesize_wiki)
## also used by: extract_complex_contents (ExtractorRegistry uses OpenAI, same key)
OPENAI_API_KEY=sk-...

# --- Langfuse Tracing (optional) ---
## used by: workflows/wiki_synthesis (traces every per-item synthesis run)
LANGFUSE_PUBLIC_KEY=...
LANGFUSE_SECRET_KEY=...
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development # Use "production" on deployment

# DATABASE_URL is composed in docker-compose.yml from DAGSTER_PG_*;
# for local `poe dev` outside docker, set it explicitly:
# DATABASE_URL=postgresql://${DAGSTER_PG_USERNAME}:${DAGSTER_PG_PASSWORD}@localhost:5432/knowledge_pipeline

# --- DAG synthesize_wiki ---
# Required: DATABASE_URL (above), OPENAI_API_KEY (above), BACKUP_DIR (below — reads
# the snapshot raw_store.db produced by backup_readings).
# Optional: LANGFUSE_* (above) for LLM tracing; WIKI_MAX_PER_TICK (default 30, 0 = no cap).

# --- DAG populate_vector_store ---
# Required: BACKUP_SOURCE_DIR (below), OPENAI_API_KEY (above), and:
# Local dev (e.g. `poe dagster-dev`): point at a chroma run launched locally.
# Docker Compose: dagster-code's `environment:` overrides CHROMA_HOST=chroma.
CHROMA_HOST=localhost
CHROMA_PORT=8000
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMS=1536

# --- DAG backup_readings ---
# All required — unset → run init fails with a clear env-var error.
BACKUP_SOURCE_DIR=/home/.../newsletter-assistant/data  # Absolute path to source DB dir
BACKUP_DIR=/home/.../knowledge-pipeline/backups        # Absolute path to local snapshot landing dir
DRIVE_REMOTE=gdrive                                    # rclone remote name
DRIVE_BACKUP_ROOT=...backups-dev                       # path prefix on the remote
HEALTHCHECK_PING_URL=https://hc-ping.com/<uuid>

# --- DAG extract_queued_items ---
# Sensor-driven Notion-queue pipeline; all required — unset → run init fails.
# Env-var prefix is intentionally shorter than the pipeline name
# (EXTRACT_QUEUE_* vs extract_queued_items_*) for readability at container start.
NOTION_INTEGRATION_TOKEN=secret_...                    # Internal Integration secret; reuse the existing one or create a fresh one for Dagster
NOTION_QUEUE_DB_ID=...                                 # Knowledge OS Queue DB id (with or without dashes); kept for documentation + future page-create write paths
NOTION_QUEUE_DATA_SOURCE_ID=...                        # Data source id under the Queue DB (Notion 2.x: queries run against data sources, not databases). Fetch the DB once and read `data_sources[0].id`, or copy from the create-database response's `collection://` URL.
PI_SOCKS5_URL=socks5://user:pass@host:1080             # Pi-hosted SOCKS5 proxy; used by curl-cffi fallback
# YOUTUBE_PROXY_URL=                                   # Optional HTTPS proxy for YouTube transcript fetches; leave unset if direct access works
EXTRACT_QUEUE_IMPERSONATE_PROFILE=safari17_0           # curl-cffi browser TLS fingerprint (per 2026-05-22 NA smoke test)
EXTRACT_QUEUE_MODEL=gpt-4o-mini                        # dev; switch to gpt-4o for prod
# OPENAI_API_KEY (above) is shared — used by both synthesize_wiki and extract_complex_contents
LLAMA_CLOUD_API_KEY=                                # LlamaCloud API key for arxiv PDF rendering
LLAMA_PARSE_TIER=fast                               # dev: fast (cheapest, layout-only). prod: agentic_plus (highest fidelity). Other tiers: balanced, premium, agentic

# --- Fetcher service ---
# Required by services/fetcher; Phase 0 only validates these are set.
FETCHER_JINA_API_KEY=                               # Jina Reader API key
FETCHER_SOCKS5_URL=socks5://raspberry-pi-host:1080  # SOCKS5 proxy used by browser-like fallback fetches
FETCHER_LLAMA_PARSE_API_KEY=                        # LlamaParse API key
# FETCHER_DB_PATH=/app/data/fetcher.db
# FETCHER_CACHE_TTL_DAYS=365
# FETCHER_BATCH_MAX=100
# FETCHER_DEFAULT_TIMEOUT_S=30
# FETCHER_LLAMA_PARSE_TIER_ARXIV=agentic_plus
