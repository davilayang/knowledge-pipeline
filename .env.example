# Copy to .env and fill in values. Optional vars short-circuit cleanly when unset.

# --- Dagster Postgres (docker-compose only) ---
DAGSTER_PG_HOST=postgres
DAGSTER_PG_PORT=5432
DAGSTER_PG_USERNAME=...
DAGSTER_PG_PASSWORD=...
DAGSTER_PG_DB=dagster

# --- LLM API keys ---
## used by: workflows/
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...           # optional — only when using Claude

# --- Langfuse Tracing (optional) ---
## used by:
LANGFUSE_PUBLIC_KEY=...
LANGFUSE_SECRET_KEY=...
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Application database (wiki + LangGraph checkpoints) ---
# Same Postgres instance as Dagster's run history; different database.
# In docker host=postgres; for local `poe dev`, override to host=localhost.
DATABASE_URL=postgresql://${DAGSTER_PG_USERNAME}:${DAGSTER_PG_PASSWORD}@postgres:5432/knowledge_pipeline

# --- backup_readings DAG (all optional) ---
BACKUP_SOURCE_DIR=~/newsletter-assistant/data
BACKUP_DIR=./backups
DRIVE_REMOTE=gdrive                  # rclone remote; unset disables Drive offload + prune
# HEALTHCHECK_PING_URL=https://hc-ping.com/<uuid>
