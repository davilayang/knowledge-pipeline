# Copy to .env and fill in values. Lines marked "(optional)" can be left
# commented; their consumers short-circuit when unset.

# --- Dagster Postgres (consumed by docker-compose.yml) ---
DAGSTER_PG_HOST=postgres
DAGSTER_PG_PORT=5432
DAGSTER_PG_USERNAME=...
DAGSTER_PG_PASSWORD=...
DAGSTER_PG_DB=dagster

# --- LLM API keys (used by wiki synthesis + future judge models) ---
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# --- Langfuse Tracing (optional — leave blank to disable) ---
LANGFUSE_PUBLIC_KEY=...
LANGFUSE_SECRET_KEY=...
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Application database — wiki tables + langgraph_checkpoints ---
# In docker compose, host=postgres; for local `uv run poe dev`, host=localhost.
DATABASE_URL=postgresql://${DAGSTER_PG_USERNAME}:${DAGSTER_PG_PASSWORD}@postgres:5432/knowledge_pipeline

# --- backup_readings DAG (all optional) ---

# Source SQLite DBs. Set to data folder of newsletter-assistant project
BACKUP_SOURCE_DIR=~/GitHub/newsletter-assistant/data

# Local snapshot landing dir. Default = <repo>/backups.
# BACKUP_DIR=./backups

# rclone remote name. Unset to disable: Drive upload + capacity check + Drive prune
# DRIVE_REMOTE=gdrive

# healthchecks.io ping URL. Unset to disable: ping_healthcheck_on_success sensor
# HEALTHCHECK_PING_URL=https://hc-ping.com/<uuid>
