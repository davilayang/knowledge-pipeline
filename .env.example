# Copy to .env and fill in values. Lines marked "(optional)" can be left
# unset or commented; their consumers short-circuit when missing.
#
# Two distinct consumer groups:
#   - Compose-time vars are read by docker-compose.yml when bringing services up
#     (substituted into container environment, volume paths, etc.).
#   - Runtime vars are read by application code inside the dagster-code container
#     (and locally when running `uv run poe dev` outside docker).
#
# In docker mode, compose forwards the runtime vars from this file into the
# dagster-code container's environment block. For local dev, just having them
# in your shell environment (or sourcing this file) is enough.


# =============================================================================
# Compose-time
# =============================================================================

# Dagster's own Postgres-backed run history.
# Consumed by: docker-compose.yml (creates the postgres service + injects
#              DAGSTER_POSTGRES_* into the dagster-code/webserver/daemon).
# Required: yes (docker mode). For local `uv run poe dev`, you manage your
#           own Postgres separately.
DAGSTER_PG_HOST=postgres
DAGSTER_PG_PORT=5432
DAGSTER_PG_USERNAME=...
DAGSTER_PG_PASSWORD=...
DAGSTER_PG_DB=dagster


# =============================================================================
# Runtime — LLM API keys
# =============================================================================

# Consumed by: workflows/llm.py (via langchain_openai / langchain_anthropic).
# Used in: wiki synthesis (extraction + page synthesis), RAG eval, future judges.
# Required: OPENAI_API_KEY is required for the wiki workflow today.
#           ANTHROPIC_API_KEY is optional now; needed when a judge or workflow
#           switches to a Claude model.
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...


# =============================================================================
# Runtime — Observability (optional)
# =============================================================================

# Consumed by: workflows/shared/observability.py — process-cached
#              langfuse.langchain.CallbackHandler attached to every LLM call
#              and to graph.invoke configs (nested traces).
# Used in: every LLM-driven workflow + the wiki_synthesis runner.
# Behavior when unset: handler is silently skipped, no warning, no traces.
LANGFUSE_PUBLIC_KEY=...
LANGFUSE_SECRET_KEY=...
LANGFUSE_HOST=https://cloud.langfuse.com


# =============================================================================
# Runtime — Application database (wiki + LangGraph checkpoints)
# =============================================================================

# Consumed by: WikiResource.get_database_url() (Dagster asset boundary),
#              workflows/wiki_synthesis/runner.py (PostgresSaver checkpointer +
#              the commit transaction in nodes.py).
# Used in: wiki.processed / wiki.pages / wiki.aliases tables and the
#          langgraph_checkpoints schema. Same Postgres instance as Dagster's
#          run history; different database (knowledge_pipeline).
# Required: yes for the wiki synthesis pipeline.
# Note: in docker, host=postgres (service DNS). For local `uv run poe dev`,
#       override to host=localhost.
DATABASE_URL=postgresql://${DAGSTER_PG_USERNAME}:${DAGSTER_PG_PASSWORD}@postgres:5432/knowledge_pipeline


# =============================================================================
# Runtime — backup_readings DAG (all optional)
# =============================================================================
# Each var has its own short-circuit. Unset means "skip the corresponding
# asset" — useful on laptop/dev where you don't want Drive uploads firing.

# Source SQLite DBs to back up. Typically the data folder of the
# newsletter-assistant project. Unset → backup_readings has nothing to snapshot.
# Consumed by: backup_readings/resources.py
BACKUP_SOURCE_DIR=~/GitHub/newsletter-assistant/data

# Local snapshot landing dir. Default = <repo>/backups (mounted into the
# dagster-code container at /app/backups).
# Consumed by: backup_readings/resources.py
# BACKUP_DIR=./backups

# rclone remote name. Unset → disables Drive upload, capacity check, and
# Drive-side retention prune; local snapshots still happen.
# Consumed by: backup_readings/assets.py (drive_*-prefixed assets)
# DRIVE_REMOTE=gdrive

# healthchecks.io ping URL. Unset → disables the success-ping sensor.
# Consumed by: backup_readings/sensors.py (ping_healthcheck_on_success)
# HEALTHCHECK_PING_URL=https://hc-ping.com/<uuid>
