# Fetcher service - required envs (set on the Hetzner deploy box's .env)
FETCHER_JINA_API_KEY=
FETCHER_SOCKS5_URL=socks5://raspberry-pi-host:1080
FETCHER_LLAMA_PARSE_API_KEY=

# Optional overrides:
# FETCHER_DB_PATH=/app/data/fetcher.db
# FETCHER_CACHE_TTL_DAYS=365
# FETCHER_BATCH_MAX=100
# FETCHER_DEFAULT_TIMEOUT_S=30
# FETCHER_LLAMA_PARSE_TIER_ARXIV=agentic_plus
